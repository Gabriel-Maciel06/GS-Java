# ==============================================================================
# AlertaCom — Plataforma CitizenTech de Resiliência Urbana e Defesa Civil
# Variáveis de Ambiente e Configuração de Infraestrutura Docker
# FIAP — Global Solution 2026/2 (Turma 2TDSR)
# Integrantes:
#   - Vitória Rodrigues Martins (RM 565160)
#   - Thomas Fontes (RM 562254)
#   - Gabriel Maciel Alves de Oliveira (RM 562795)
#   - Matheus Pereira Molina (RM 563399)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configurações Gerais do Spring Boot & Servidor Web
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=docker
SERVER_PORT=8080

# ------------------------------------------------------------------------------
# 2. Banco de Dados Relacional — Oracle Database 23c Free (Faststart)
# ------------------------------------------------------------------------------
# Senha administrativa do SYS/SYSTEM no container Oracle:
ORACLE_PASSWORD=alertacom_pwd

# Usuário de aplicação e senha correspondente (utilizado pelo Spring Data JPA):
ORACLE_USER=alertacom
ORACLE_APP_PASSWORD=alertacom_pwd

# JDBC Connection Strings (injetadas na API):
SPRING_DATASOURCE_URL=jdbc:oracle:thin:@oracle-db:1521/FREEPDB1
SPRING_DATASOURCE_USERNAME=alertacom
SPRING_DATASOURCE_PASSWORD=alertacom_pwd

# ------------------------------------------------------------------------------
# 3. Broker de Mensageria Assíncrona — RabbitMQ 3.13 Management
# ------------------------------------------------------------------------------
# Credenciais do Broker AMQP:
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# Conexão AMQP da API AlertaCom com o Broker:
SPRING_RABBITMQ_HOST=rabbitmq
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest

# ------------------------------------------------------------------------------
# 4. Segurança & Autenticação JWT (HMAC-SHA256)
# ------------------------------------------------------------------------------
# ATENÇÃO: Nos perfis 'docker' e 'prod', a aplicação exige chave com no mínimo
# 32 caracteres (256 bits) e REJEITA a chave padrão de desenvolvimento por segurança.
JWT_SECRET=AlertaComSuperChaveSecretaGlobalSolutionFIAP2026ProducaoSegura
JWT_EXPIRATION_HOURS=24

# ------------------------------------------------------------------------------
# 5. Inteligência Artificial — Spring AI & OpenAI API
# ------------------------------------------------------------------------------
# Chave da API OpenAI para geração de boletins meteorológicos informativos.
# Quando vazia ou preenchida com "mock-key-docker", o motor heurístico resiliente
# determinístico offline assume a geração automaticamente sem falhar.
OPENAI_API_KEY=mock-key-docker
SPRING_AI_OPENAI_CHAT_OPTIONS_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 6. Seed Inicial do Gestor Municipal (Bootstrap Seguro)
# ------------------------------------------------------------------------------
ALERTACOM_GESTOR_DEFAULT_EMAIL=gestor@alertacom.com.br
ALERTACOM_GESTOR_DEFAULT_SENHA=Gestor@2026!
ALERTACOM_GESTOR_DEFAULT_NOME=Gestor Defesa Civil
ALERTACOM_GESTOR_DEFAULT_TELEFONE=(11) 99999-0000
ALERTACOM_GESTOR_DEFAULT_BAIRRO=Centro
